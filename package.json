{
	"name": "masthead",
	"version": "1.0.0",
	"private": true,
	"description": "Kanban publishing workflows for wp-admin.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js src tests/e2e",
		"lint:css": "wp-scripts lint-style 'src/**/*.scss'",
		"env": "wp-env",
		"env:start": "wp-env start",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/masthead vendor/bin/phpunit",
		"test:e2e": "wp-scripts test-playwright --config tests/e2e/playwright.config.js",
		"make-pot": "wp-env run cli --env-cwd=wp-content/plugins/masthead wp i18n make-pot . languages/masthead.pot --exclude=node_modules,vendor,src,tests"
	},
	"devDependencies": {
		"@playwright/test": "1.64",
		"@wordpress/e2e-test-utils-playwright": "^3.0.0",
		"@wordpress/env": "^11.17.0",
		"@wordpress/scripts": "^36.1.0"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@wordpress/a11y": "^4.57.0",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/compose": "^8.10.0",
		"@wordpress/core-data": "^8.2.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/date": "^5.57.0",
		"@wordpress/dom-ready": "^4.57.0",
		"@wordpress/editor": "^15.2.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/hooks": "^4.57.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/icons": "^18.0.0",
		"@wordpress/plugins": "^7.57.0",
		"@wordpress/url": "^4.57.0"
	}
}
