{
	"name": "patelutkarsh/masthead",
	"description": "Kanban publishing workflows for wp-admin.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/PatelUtkarsh/masthead",
	"keywords": [ "wordpress", "plugin", "editorial", "workflow", "kanban" ],
	"support": {
		"issues": "https://github.com/PatelUtkarsh/masthead/issues",
		"source": "https://github.com/PatelUtkarsh/masthead"
	},
	"require": {
		"php": ">=8.4",
		"composer/installers": "^2.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^4.0",
		"wp-coding-standards/wpcs": "^3.3",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"autoload-dev": {
		"psr-4": {
			"Masthead\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"platform": {
			"php": "8.4.0"
		},
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"test": "phpunit"
	}
}
